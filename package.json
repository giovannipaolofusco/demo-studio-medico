{
  "name": "demo-studio-medico",
  "private": true,
  "scripts": {
    "build": "npm run genera && npm run copia && npm run html && npm run js && npm run css && npm run img",
    "genera": "node scripts/genera.mjs .",
    "copia": "node scripts/copia.mjs",
    "html": "node scripts/minifica-html.mjs",
    "js": "node scripts/minifica-js.mjs",
    "css": "postcss dist/assets/css/style.css --use cssnano --no-map -o dist/assets/css/style.css",
    "img": "node scripts/immagini.mjs"
  },
  "devDependencies": {
    "cssnano": "^8.0.10",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sharp": "^0.35.5",
    "terser": "^5.51.2"
  }
}
